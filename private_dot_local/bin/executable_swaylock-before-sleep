#!/usr/bin/env python3
"""Lock the session before suspend.

Run from swayidle's before-sleep hook. While the hook runs, swayidle holds
a logind "sleep" delay inhibitor, and every process it spawns inherits that
inhibitor fd. A plain `swaylock -f` daemonizes while keeping the fd, so the
inhibitor stays held until unlock; logind then waits the full
InhibitDelayMaxSec (5 s), logs "inhibitor timeout is reached", and suspends
anyway.

subprocess.run() closes inherited fds by default, and it waits for the
swaylock parent, which exits only after the compositor confirms the lock,
so suspend cannot race the lock surface.
"""

import subprocess
import sys


def main() -> int:
    # Already locked (e.g. swayidle's idle timeout won the race): nothing to do.
    if subprocess.run(
        ["pidof", "swaylock"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0:
        return 0

    return subprocess.run(["swaylock", "-f"]).returncode


if __name__ == "__main__":
    sys.exit(main())
